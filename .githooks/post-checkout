#!/bin/sh
#
# Run gulp build after switching branches so generated assets match the branch.
#
# Git passes:
#   $1 = ref of the previous HEAD
#   $2 = ref of the new HEAD
#   $3 = 1 on branch checkout, 0 on file checkout
#
# Opt out for a single checkout:
#   FC_SKIP_POST_CHECKOUT_BUILD=1 git checkout other-branch

if [ "$3" != "1" ]; then
	exit 0
fi

if [ -n "$FC_SKIP_POST_CHECKOUT_BUILD" ]; then
	exit 0
fi

ROOT="$(git rev-parse --show-toplevel)" || exit 0
cd "$ROOT" || exit 0

if [ ! -f "gulpfile.js" ]; then
	exit 0
fi

if [ ! -x "node_modules/.bin/gulp" ]; then
	echo "post-checkout: skipping gulp build (run npm install first)."
	exit 0
fi

echo "post-checkout: running gulp build..."
./node_modules/.bin/gulp build
