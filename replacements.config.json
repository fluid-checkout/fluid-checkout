{
	"manifest_description": "Third-party files replaced or forked by Fluid Checkout.",
	"wp_content_relative": "../../",
	"categories": [
		"plugin-compat-js",
		"theme-compat-js",
		"woocommerce-js",
		"plugin-compat-template",
		"theme-compat-template",
		"woocommerce-template"
	],
	"scan": {
		"woocommerce_templates_dir": "templates/fc",
		"compat_templates_dir": "templates/compat",
		"plugin_compat_js_dir": "js-src/compat/plugins",
		"theme_compat_js_dir": "js-src/compat/themes",
		"compat_php_dir": "inc/compat"
	},
	"exclude_template_package": "fluid-checkout",
	"fc_only_template_basenames": [
		"form-contact.php",
		"form-contact-login.php",
		"form-contact-login-modal.php",
		"form-account-creation.php",
		"review-order-section.php",
		"form-payment.php",
		"form-additional-fields.php",
		"page-checkout.php",
		"page-checkout-header.php",
		"page-checkout-footer.php",
		"checkout-header.php",
		"checkout-footer.php"
	],
	"script_handle_overrides": {
		"js-src/compat/plugins/woocommerce-extra-checkout-fields-for-brazil/frontend.js": "woocommerce-extra-checkout-fields-for-brazil-front",
		"js-src/compat/plugins/biteship/biteship-public.js": "biteship",
		"js-src/compat/plugins/wc-multivendor-marketplace/wcfmmp-script-checkout-location.js": "wcfmmp_checkout_location_js"
	},
	"their_path_overrides": {
		"js-src/compat/plugins/klarna-payments-for-woocommerce/klarna-payments.js": "assets/js/klarna-payments.js",
		"js-src/compat/plugins/yith-woocommerce-checkout-manager/frontend.js": "assets/js/frontend.js",
		"js-src/compat/plugins/wordfence/login.js": "modules/login-security/js/login.js",
		"js-src/compat/plugins/woocommerce-extra-checkout-fields-for-brazil/frontend.js": "assets/js/frontend/frontend.js",
		"js-src/compat/plugins/woocommerce-eu-vat-field/frontend-checkout-page.js": "assets/js/frontend-checkout-page.js",
		"js-src/compat/plugins/woocommerce-eu-vat-field/frontend-eu-vat-field-visibility.js": "assets/js/frontend-eu-vat-field-visibility.js",
		"js-src/compat/plugins/woo-mailerlite/woo-mailerlite-public.js": "public/js/woo-mailerlite-public.js",
		"js-src/compat/plugins/woocommerce-superfaktura/checkout.js": "assets/js/checkout.js",
		"js-src/compat/plugins/hezarfen-for-woocommerce/checkout.js": "assets/js/checkout.js",
		"js-src/compat/plugins/wc-brt-fermopoint-shipping-methods/wc_brt_fermopoint_shipping_methods_js.js": "assets/js/wc_brt_fermopoint_shipping_methods_js.js",
		"js-src/compat/plugins/wc-postcode-checker/wc-postcode-checker.js": "assets/js/wc-postcode-checker.js",
		"js-src/compat/plugins/states-cities-and-places-for-woocommerce/place-select.js": "js/place-select.js",
		"js-src/compat/plugins/rvvup-for-woocommerce/scripts.js": "assets/js/scripts.js",
		"js-src/compat/plugins/woocommerce-gus/gus.js": "assets/js/gus.js",
		"js-src/compat/plugins/fooevents/events-frontend.js": "js/events-frontend.js",
		"js-src/compat/plugins/biteship/biteship-public.js": "public/js/biteship-public.js",
		"js-src/compat/plugins/box-now-delivery-croatia/box-now-delivery.js": "js/box-now-delivery.js",
		"js-src/compat/plugins/automation-web-platform/checkout.js": "assets/js/checkout.js",
		"js-src/compat/plugins/eu-vat-for-woocommerce/alg-wc-eu-vat.js": "assets/js/alg-wc-eu-vat.js",
		"js-src/compat/plugins/mobile-login-woocommerce-premium/xoo-ml-phone-js.js": "assets/js/xoo-ml-phone-js.js",
		"js-src/compat/plugins/wc-multivendor-marketplace/wcfmmp-script-checkout-location.js": "assets/js/checkout/wcfmmp-script-checkout-location.js",
		"templates/compat/plugins/woocommerce-germanized/checkout/order-submit.php": "templates/checkout/order-submit.php",
		"templates/compat/plugins/curiero-plugin/templates/checkout-collectpoint-select.php": "includes/shipping_methods/fancourier/templates/checkout-collectpoint-select.php",
		"templates/compat/plugins/curiero-plugin/templates/checkout-dpd-boxes-select.php": "includes/shipping_methods/dpd/templates/checkout-dpd-boxes-select.php",
		"templates/compat/plugins/curiero-plugin/templates/checkout-lockers-select.php": "includes/shipping_methods/sameday/templates/checkout-lockers-select.php",
		"templates/compat/plugins/lp-express-shipping-method-for-woocommerce/checkout/lpexpress_terminals.php": "woocommerce/checkout/lpexpress_terminals.php",
		"templates/compat/plugins/woo-shipping-dpd-baltic/checkout/form-shipping-dpd-terminals-with-map.php": "public/woocommerce/checkout/form-shipping-dpd-terminals-with-map.php",
		"templates/compat/plugins/woo-shipping-dpd-baltic/checkout/form-shipping-dpd-terminals.php": "public/woocommerce/checkout/form-shipping-dpd-terminals.php",
		"templates/compat/plugins/woo-ups-pickup/cart/pickup-button-html.php": "includes/templates/pickup-button-html.php",
		"templates/compat/plugins/woo-ups-pickup/cart/pickup-location.php": "templates/pickup-location.php",
		"templates/compat/plugins/woocommerce-germanized/checkout/dhl/preferred-services.php": "plugins/shiptastic-integration-for-dhl/templates/checkout/dhl/preferred-services.php",
		"templates/compat/plugins/woocommerce-subscriptions/cart/cart-recurring-shipping.php": "templates/cart/cart-recurring-shipping.php",
		"js-src/compat/plugins/astra-addon/checkout-labels-as-placeholders.js": "assets/js/checkout-labels-as-placeholders.js",
		"js-src/compat/themes/goya/float-labels.js": "assets/js/float-labels.js",
		"js-src/compat/themes/flatsome/float-labels.js": "inc/extensions/flatsome-wc-cart/inc/float-labels.js",
		"js-src/compat/themes/fennik/lazy-load.js": "assets/js/lazy-load.js"
	},
	"resolve_their_path_wordpress_org_svn": true,
	"their_path_url_by_category": {},
	"woocommerce_js_entries": [
		{
			"our_path": "js-src/checkout.js",
			"their_path": "assets/js/frontend/checkout.js",
			"script_handle": "wc-checkout"
		},
		{
			"our_path": "js-src/country-select.js",
			"their_path": "assets/js/frontend/country-select.js",
			"script_handle": "wc-country-select"
		},
		{
			"our_path": "js-src/woocommerce.js",
			"their_path": "assets/js/frontend/woocommerce.js",
			"script_handle": "woocommerce"
		},
		{
			"our_path": "js-src/address-i18n.js",
			"their_path": "assets/js/frontend/address-i18n.js",
			"script_handle": "wc-address-i18n"
		},
		{
			"our_path": "js-src/password-strength-meter.js",
			"their_path": "assets/js/frontend/password-strength-meter.js",
			"script_handle": "wc-password-strength-meter"
		}
	]
}
