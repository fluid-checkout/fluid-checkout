msgid "Addresses"
msgstr "Adreses"

#: inc/admin/admin-settings-cart.php:123
msgid "Enable cart page optimizations to see more options"
msgstr "Iespējojiet iepirkumu groza lapas optimizācijas, lai redzētu vairāk iespēju"

