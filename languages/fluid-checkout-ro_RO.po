msgstr "Codul de țară al numărului de telefon și validarea acestuia"

#: inc/admin/admin-settings-international-phone.php:169
msgid "Country"
msgstr "Țară"

#: inc/admin/admin-settings-international-phone.php:170
msgid "Enable country on phone fields"
msgstr "Activați câmpurile referitoare la țară pe telefon"

