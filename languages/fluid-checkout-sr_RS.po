msgstr "Подаци о коришћењу нису послати. Покушајте поново касније."

#: inc/admin/admin-telemetry.php:135, inc/admin/admin-telemetry.php:192
msgid "Usage tracking is not available."
msgstr "Праћење коришћења није доступно."

