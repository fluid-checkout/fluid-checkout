msgid "Utilities"
msgstr "ઉપયોગિતાઓ"

#: inc/admin/admin-settings-tools.php:159
msgid ""
"Use <code>TomSelect</code> dropdown components instead of "
"<code>select2</code>"
msgstr ""
"<code>select2</code> ને બદલે <code>TomSelect</code> ડ્રોપડાઉન ઘટકોનો ઉપયોગ "
"કરો."

