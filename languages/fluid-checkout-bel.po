msgstr ""
"Не паказваць паведамленне пра памылку тавараў у кошыку ў верхняй частцы "
"старонкі афармлення замовы. Пры адпраўцы формы афармлення заказу для "
"завяршэння пакупкі гэтыя паведамленні пра памылкі заўсёды будуць "
"адлюстроўвацца."

#: inc/admin/admin-settings-checkout.php:313
msgid "Place order"
msgstr "Размясціць заказ"

