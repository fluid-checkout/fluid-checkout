msgstr "Выберыце, які адрас захаваць у якасці адраса дастаўкі для мясцовых заказаў."

#: inc/admin/admin-settings-checkout.php:554
msgid "Save the selected pickup location"
msgstr "Захавайце абранае месца самавывазу"

