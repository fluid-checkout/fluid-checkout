msgstr ""
"Įrašykite sąskaitą išrašančios įmonės pavadinimą, remdamiesi kliento "
"pateiktu galiojančiu PVM kodu."

#: inc/admin/admin-settings-vat-assistant.php:310
msgid "Company name editing"
msgstr "Įmonės pavadinimo redagavimas"

