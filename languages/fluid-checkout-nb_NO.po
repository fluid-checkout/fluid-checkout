msgstr ""
"Aktiver optimaliseringer for takkesiden og bestillingsdetaljene for å se "
"flere alternativer"

#: inc/admin/admin-settings-order-received.php:192
msgid "Use wide layout on thank you page"
msgstr "Bruk bred layout på takkesiden"

