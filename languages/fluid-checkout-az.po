msgstr "Qadağan olunmuş giriş."

#: inc/rest-api/errors.php:69
msgid "Target user was not found."
msgstr "Hədəf istifadəçi tapılmadı."

#: inc/rest-api/errors.php:73
msgid "This feature is not available."
msgstr "Bu xüsusiyyət mövcud deyil."

