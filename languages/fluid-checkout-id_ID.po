msgstr "Tambahkan kolom telepon pengiriman ke formulir pembayaran."

#: inc/admin/admin-settings-checkout.php:594
msgid "Choose in which step to display the shipping phone field."
msgstr "Pilih di langkah mana untuk menampilkan bidang telepon pengiriman."

